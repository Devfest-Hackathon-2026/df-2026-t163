# このファイルを .env にコピーして値を入れる（.env は Git に上げない）
#   cp .env.example .env

# Places API (New) を許可した API キー
MAPS_API_KEY=

# Vertex AI（Gemini）を使う Google Cloud プロジェクト ID
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite

# 生成したスタンプを共有する Cloud Storage バケット（空なら毎回生成）と、1 日の生成上限
STAMP_BUCKET=
STAMP_DAILY_LIMIT=30
GEMINI_DAILY_LIMIT=300

# フロントの URL（カンマ区切り）。開発中は * でOK
ALLOWED_ORIGINS=*

# フロントも同じサービスで配信するとき（ローカル: ../frontend）
FRONTEND_DIR=
